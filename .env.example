# ═══════════════════════════════════════════════════════════════════════════
# AI Dzeck — environment configuration
# Copy to .env (backend reads it via pydantic-settings) or set the same
# variables in your host's env / Replit userenv.
# ═══════════════════════════════════════════════════════════════════════════

# ── Model provider (REQUIRED) ───────────────────────────────────────────────
# Primary LLM. Default below targets the NVIDIA NIM OpenAI-compatible API.
API_KEY=
API_BASE=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
MODEL_PROVIDER=openai
TEMPERATURE=0.7
MAX_TOKENS=8000

# Optional fallback LLM — used automatically when the primary provider hits
# rate limits / quota / auth errors. Without FALLBACK_* (and outside the z.ai
# runtime) there is simply no fallback.
#FALLBACK_API_BASE=
#FALLBACK_API_KEY=
#FALLBACK_MODEL_NAME=

# Optional vision model (browser screenshot analysis)
#VISION_MODEL_NAME=meta/llama-3.2-11b-vision-instruct
#VISION_MODEL_PROVIDER=openai
#VISION_API_BASE=https://integrate.api.nvidia.com/v1
#VISION_API_KEY=

# Optional model used for session title generation
#SUMMARY_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b

# ── MongoDB (REQUIRED) ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=manus
#MONGODB_USERNAME=
#MONGODB_PASSWORD=

# ── Redis (REQUIRED) ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
#REDIS_DB=0
#REDIS_PASSWORD=

# ── Sandbox ─────────────────────────────────────────────────────────────────
# Replit-local sandbox services (Xvfb + Chrome + VNC via supervisord)
SANDBOX_BASE_URL=http://localhost:8080
SANDBOX_VNC_URL=ws://localhost:5901
SANDBOX_CDP_URL=http://localhost:8222
SANDBOX_TTL_MINUTES=30
# Virtual display size — MUST match the Xvfb -screen argument in
# sandbox/replit_supervisord.conf. The browser window is force-fitted to
# exactly this size via CDP (no window manager in the sandbox), which keeps
# the live VNC view in sync with the tool screenshots.
# NOTE: this is the REPLIT/LOCAL sandbox size ONLY. The E2B microVM always
# runs its own 1024x768 Xvfb (hardcoded in e2b_sandbox.py to fit ~0.5 GB
# RAM) and its browser windows are fitted to THAT size — do NOT point this
# setting at E2B (an oversized window overflows the display and the live
# VNC takeover looks shifted/cropped).
SANDBOX_DISPLAY_SIZE=1280x1029
# Where per-user sandbox homes live (Replit default shown)
#USER_HOME_ROOT=/home/runner/users
# App source the sandbox agent must never touch (colon/comma separated)
#SANDBOX_PROTECTED_PATHS=/home/runner/workspace

# Sandbox provider: "auto" (E2B first, local fallback) | "e2b" | "replit"
SANDBOX_PROVIDER=auto
E2B_API_KEY=
# Seconds before an idle E2B sandbox is paused (paused = not billed)
E2B_SANDBOX_TIMEOUT=900

# ── Browser ─────────────────────────────────────────────────────────────────
# Engine: "browser_use" (default, rich DOM state) | "playwright"
BROWSER_ENGINE=browser_use

# ── Search ──────────────────────────────────────────────────────────────────
# Providers: baidu, baidu_web, google, bing, bing_web, bing_rss, tavily
SEARCH_PROVIDER=tavily
# Automatic fallback when the primary is unreachable (applies to tavily)
SEARCH_FALLBACK_PROVIDER=bing_rss
#TAVILY_API_KEY=
#BAIDU_SEARCH_API_KEY=
#BING_SEARCH_API_KEY=
#GOOGLE_SEARCH_API_KEY=
#GOOGLE_SEARCH_ENGINE_ID=

# ── Auth ────────────────────────────────────────────────────────────────────
# Options: password, none, local
AUTH_PROVIDER=password
# Password auth (PASSWORD_SALT is required for password auth)
PASSWORD_SALT=
#PASSWORD_HASH_ROUNDS=10
# Local auth (only for AUTH_PROVIDER=local)
#LOCAL_AUTH_EMAIL=admin@example.com
#LOCAL_AUTH_PASSWORD=admin

# ── JWT (REQUIRED for auth) ─────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Email (optional — password-reset verification codes) ───────────────────
# Without these the "forgot password" email flow cannot send mail.
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_USERNAME=your-email@gmail.com
#EMAIL_PASSWORD=your-app-password
#EMAIL_FROM=your-email@gmail.com

# ── Client runtime config (optional) ────────────────────────────────────────
# GitHub button on the login/landing page
SHOW_GITHUB_BUTTON=false
GITHUB_REPOSITORY_URL=https://github.com/your-user/your-repo
# Claw branding toggle
CLAW_ENABLED=false
# Google Analytics measurement ID (e.g. G-XXXXXXXXXX)
#GOOGLE_ANALYTICS_ID=

# ── Agent tuning (optional — sane defaults) ─────────────────────────────────
# Orchestration driver: "langgraph" (default) | "custom"
#AGENT_FLOW_ENGINE=langgraph
# Max plan steps before force-summarising
#MAX_STEPS=50
# Consecutive failed steps before skipping to SUMMARIZING
#MAX_CONSECUTIVE_FAILURES=3
# Soft budget (chars) on the conversation before progressive compaction
# (provider error-1261 defense). 0 disables the proactive gate.
#AGENT_CONTEXT_SOFT_LIMIT_CHARS=280000
# Hard cap (chars) on a single serialized tool result entering the LLM context
#AGENT_TOOL_RESULT_MAX_CHARS=48000
# Extra instructions appended to all agent system prompts at runtime
#EXTEND_SYSTEM_MESSAGE=

# ── Misc ────────────────────────────────────────────────────────────────────
#MCP_CONFIG_PATH=/home/runner/workspace/mcp.json
LOG_LEVEL=INFO
# Set true ONLY if your LLM gateway has a valid public certificate
SSL_VERIFY=false
# Extra headers for LLM requests (JSON)
#EXTRA_HEADERS={"X-Custom-Header":"value"}

# ── Frontend build-time (only when hosting the frontend on another origin) ──
#VITE_API_URL=https://your-backend-host
