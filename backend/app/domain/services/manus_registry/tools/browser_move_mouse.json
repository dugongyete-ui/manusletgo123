{
  "schema_version": "1.1",
  "name": "browser_move_mouse",
  "transport": "mcp",
  "server": "manus-tools",
  "description": "Move cursor.",
  "input_schema": {
    "type": "object",
    "properties": {
      "brief": {
        "type": "string",
        "description": "One-sentence purpose of the operation"
      },
      "viewport_width": {
        "type": "number"
      },
      "viewport_height": {
        "type": "number"
      },
      "coordinate_x": {
        "type": "number"
      },
      "coordinate_y": {
        "type": "number"
      }
    },
    "required": [
      "brief",
      "viewport_width",
      "viewport_height",
      "coordinate_x",
      "coordinate_y"
    ]
  },
  "policy": {
    "requires_confirmation": false,
    "destructive": false,
    "side_effects": "none"
  }
}
