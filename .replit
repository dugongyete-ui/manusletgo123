modules = ["python-3.12", "vue-node-20", "nodejs-20", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["cargo", "gdb", "gitFull", "libiconv", "libxcrypt", "openssl", "pkg-config", "playwright-driver", "rustc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && pnpm approve-builds --yes 2>/dev/null; pnpm dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python3 -m uvicorn app.main:app --host localhost --port 8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[deployment]
deploymentTarget = "static"
build = ["bash", "-c", "cd frontend && pnpm install && pnpm build"]
publicDir = "frontend/dist"

[userenv]

[userenv.shared]
API_BASE = "https://api.cohere.com/compatibility/v1"
MODEL_NAME = "command-a-03-2025"
MODEL_PROVIDER = "openai"
TEMPERATURE = "0.7"
MAX_TOKENS = "8192"
VISION_MODEL_NAME = "command-a-vision-07-2025"
VISION_MODEL_PROVIDER = "openai"
VISION_API_BASE = "https://api.cohere.com/compatibility/v1"
MONGODB_DATABASE = "manus"
REDIS_HOST = "redis-14320.c334.asia-southeast2-1.gce.cloud.redislabs.com"
REDIS_PORT = "14320"
SEARCH_PROVIDER = "tavily"
AUTH_PROVIDER = "password"
JWT_ALGORITHM = "HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = "1440"
JWT_REFRESH_TOKEN_EXPIRE_DAYS = "30"
CLAW_ENABLED = "false"
LOG_LEVEL = "INFO"
MCP_CONFIG_PATH = "/home/runner/workspace/mcp.json"
SUMMARY_MODEL_NAME = "command-r7b-12-2024"
E2B_TEMPLATE_ID = "1gsznx7zzecjwwwghuzw"
