{
  "schema_version": "1.1",
  "name": "generate_image",
  "transport": "mcp",
  "server": "manus-tools",
  "description": "Generate images using AI.",
  "input_schema": {
    "type": "object",
    "properties": {
      "brief": {
        "type": "string",
        "description": "One-sentence purpose of the operation"
      },
      "model": {
        "type": "string",
        "enum": [
          "default",
          "nano-banana-2",
          "nano-banana-pro",
          "gpt-image-2.5"
        ]
      },
      "quality": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "images": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute .png or .jpg path"
            },
            "prompt": {
              "type": "string"
            },
            "aspect_ratio": {
              "type": "string",
              "enum": [
                "auto",
                "1:1",
                "2:3",
                "3:2",
                "3:4",
                "4:3",
                "4:5",
                "5:4",
                "9:16",
                "16:9",
                "21:9"
              ]
            },
            "references": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "transparent_background": {
              "type": "string",
              "pattern": "^(#[0-9A-Fa-f]{6})?$"
            }
          }
        }
      }
    },
    "required": [
      "brief",
      "model",
      "images"
    ]
  },
  "policy": {
    "requires_confirmation": false,
    "destructive": false,
    "side_effects": "creates_file"
  }
}
