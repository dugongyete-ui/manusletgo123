{
  "schema_version": "1.1",
  "name": "webdev_take_screenshot",
  "transport": "mcp",
  "server": "manus-tools",
  "description": "Capture project preview screenshots.",
  "input_schema": {
    "type": "object",
    "properties": {
      "brief": {
        "type": "string",
        "description": "One-sentence purpose of the operation"
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "full_page": {
        "type": "boolean"
      },
      "viewport_size": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      }
    },
    "required": [
      "brief"
    ]
  },
  "policy": {
    "requires_confirmation": false,
    "destructive": false,
    "side_effects": "none"
  }
}
