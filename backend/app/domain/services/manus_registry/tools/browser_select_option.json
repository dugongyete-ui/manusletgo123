{
  "schema_version": "1.1",
  "name": "browser_select_option",
  "transport": "mcp",
  "server": "manus-tools",
  "description": "Select dropdown option.",
  "input_schema": {
    "type": "object",
    "properties": {
      "brief": {
        "type": "string",
        "description": "One-sentence purpose of the operation"
      },
      "index": {
        "type": "integer"
      },
      "option_index": {
        "type": "integer"
      }
    },
    "required": [
      "brief",
      "index",
      "option_index"
    ]
  },
  "policy": {
    "requires_confirmation": false,
    "destructive": false,
    "side_effects": "none"
  }
}
