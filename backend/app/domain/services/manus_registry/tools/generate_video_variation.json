{
  "schema_version": "1.1",
  "name": "generate_video_variation",
  "transport": "mcp",
  "server": "manus-tools",
  "description": "Modify an existing video.",
  "input_schema": {
    "type": "object",
    "properties": {
      "brief": {
        "type": "string",
        "description": "One-sentence purpose of the operation"
      },
      "path": {
        "type": "string",
        "pattern": "^/.+\\.mp4$"
      },
      "model": {
        "type": "string",
        "enum": [
          "gemini-omni-flash-preview"
        ]
      },
      "video": {
        "type": "string"
      },
      "prompt": {
        "type": "string"
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "landscape",
          "portrait"
        ]
      },
      "resolution": {
        "type": "string",
        "enum": [
          "720p"
        ]
      },
      "duration_seconds": {
        "type": "integer",
        "minimum": 3,
        "maximum": 10
      },
      "generate_audio": {
        "type": "boolean"
      }
    }
  },
  "policy": {
    "requires_confirmation": false,
    "destructive": false,
    "side_effects": "creates_file"
  },
  "notes": [
    "Only gemini-omni-flash-preview is supported."
  ]
}
