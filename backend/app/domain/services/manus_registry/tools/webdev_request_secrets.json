{
  "schema_version": "1.1",
  "name": "webdev_request_secrets",
  "transport": "mcp",
  "server": "manus-tools",
  "description": "Add or update project secrets.",
  "input_schema": {
    "type": "object",
    "properties": {
      "brief": {
        "type": "string",
        "description": "One-sentence purpose of the operation"
      },
      "message": {
        "type": "string"
      },
      "secrets": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "preventMatching": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "required": [
      "brief",
      "message",
      "secrets"
    ]
  },
  "policy": {
    "requires_confirmation": true,
    "destructive": false,
    "side_effects": "changes_secrets"
  }
}
