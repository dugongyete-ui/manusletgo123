modules = ["python-3.12", "vue-node-20", "nodejs-20", "bash", "web"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["cargo", "gdb", "gitFull", "glibcLocales", "libiconv", "libxcrypt", "openssl", "pkg-config", "playwright-driver", "rustc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-imports"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-syntax"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "frontend-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-pytest"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sandbox Services"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && pnpm approve-builds --yes 2>/dev/null; pnpm dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[[workflows.workflow]]
name = "backend-imports"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python3 -c \"import sys; sys.path.insert(0, '.'); [__import__(m) for m in ['app.core.config','app.domain.services.agents.planner','app.domain.services.agents.execution','app.domain.services.flows.plan_act','app.domain.services.agent_task_runner','app.domain.services.agent_domain_service','app.domain.services.prompts.system','app.domain.services.prompts.execution','app.domain.services.prompts.planner']]; print('PASSED')\""

[[workflows.workflow]]
name = "backend-syntax"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python3 -c \"import ast, os; [ast.parse(open(os.path.join(r,f)).read()) for r,d,fs in os.walk('app') if '__pycache__' not in r for f in fs if f.endswith('.py')]; print('PASSED')\""

[[workflows.workflow]]
name = "frontend-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npx vue-tsc --noEmit 2>&1 | tail -20 && echo 'PASSED'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "backend-pytest"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python3 -m pytest tests/ -x -q"

[[workflows.workflow]]
name = "Sandbox Services"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sandbox && /home/runner/workspace/.pythonlibs/bin/supervisord -n -c replit_supervisord.conf"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "pip install supervisor websockify --quiet && cd frontend && pnpm install --frozen-lockfile && pnpm build"]
run = ["bash", "-c", "bash /home/runner/workspace/scripts/start_production.sh"]

[userenv]

[userenv.shared]
API_BASE = "https://integrate.api.nvidia.com/v1"
MODEL_NAME = "nvidia/nemotron-3-super-120b-a12b"
MODEL_PROVIDER = "openai"
TEMPERATURE = "0.7"
MAX_TOKENS = "8000"
# Agent provider and OpenCode-inspired policy.
# existing is the default; opencode_adapter is the native Python adapter.
AGENT_PROVIDER = "existing"
# build = normal execution through all existing safety gates.
# plan = conservative read-only tool allowlist.
AGENT_MODE = "build"
AGENT_FLOW_ENGINE = "langgraph"
AGENT_PROMPT_PROFILE = "compact"
MAX_STEPS = "0"
MAX_CONSECUTIVE_FAILURES = "10"
NESTED_MAX_ITERATIONS = "0"
AGENT_CONTEXT_SOFT_LIMIT_CHARS = "280000"
AGENT_TOOL_RESULT_MAX_CHARS = "48000"
EXTEND_SYSTEM_MESSAGE = ""
# Manus registry/runtime safety contracts.
MANUS_REGISTRY_ENABLED = "true"
MANUS_MAX_IDENTICAL_CALLS = "2"
MANUS_MAX_IDENTICAL_ERRORS = "3"
MANUS_FAMILY_FAILURE_LIMIT = "3"
MANUS_MAX_RETRIES_PER_CALL = "2"
MANUS_CONFIRMATION_TTL_SECONDS = "600"
MANUS_TASK_TIMEOUT_MS = "900000"
MANUS_TOOL_TIMEOUT_SECONDS = "300"
AGENT_CONTEXT_MAX_MESSAGES = "200"
AGENT_DUPLICATE_MESSAGE_WINDOW_SECONDS = "120"
VISION_MODEL_NAME = "meta/llama-3.2-11b-vision-instruct"
VISION_MODEL_PROVIDER = "openai"
VISION_API_BASE = "https://integrate.api.nvidia.com/v1"
MONGODB_DATABASE = "manus"
REDIS_HOST = "redis-14320.c334.asia-southeast2-1.gce.cloud.redislabs.com"
REDIS_PORT = "14320"
SEARCH_PROVIDER = "tavily"
SEARCH_FALLBACK_PROVIDER = "bing_rss"
AUTH_PROVIDER = "password"
JWT_ALGORITHM = "HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = "1440"
JWT_REFRESH_TOKEN_EXPIRE_DAYS = "30"
CLAW_ENABLED = "false"
LOG_LEVEL = "INFO"
MCP_CONFIG_PATH = "/home/runner/workspace/mcp.json"
SUMMARY_MODEL_NAME = "nvidia/nemotron-3-super-120b-a12b"
SANDBOX_TTL_MINUTES = "30"
