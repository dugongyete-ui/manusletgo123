{
  "schema_version": "1.1",
  "name": "browser_press_key",
  "transport": "mcp",
  "server": "manus-tools",
  "description": "Press a browser key.",
  "input_schema": {
    "type": "object",
    "properties": {
      "brief": {
        "type": "string",
        "description": "One-sentence purpose of the operation"
      },
      "key": {
        "type": "string"
      }
    },
    "required": [
      "brief",
      "key"
    ]
  },
  "policy": {
    "requires_confirmation": false,
    "destructive": false,
    "side_effects": "none"
  }
}
