{
  "schema_version": "1.1",
  "name": "browser_navigate",
  "transport": "mcp",
  "server": "manus-tools",
  "description": "Navigate to a URL.",
  "input_schema": {
    "type": "object",
    "properties": {
      "brief": {
        "type": "string",
        "description": "One-sentence purpose of the operation"
      },
      "url": {
        "type": "string"
      },
      "intent": {
        "type": "string",
        "enum": [
          "navigational",
          "informational",
          "transactional"
        ]
      },
      "focus": {
        "type": "string"
      }
    },
    "required": [
      "brief",
      "url",
      "intent"
    ]
  },
  "policy": {
    "requires_confirmation": false,
    "destructive": false,
    "side_effects": "none"
  }
}
