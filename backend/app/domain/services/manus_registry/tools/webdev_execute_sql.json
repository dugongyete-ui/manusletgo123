{
  "schema_version": "1.1",
  "name": "webdev_execute_sql",
  "transport": "mcp",
  "server": "manus-tools",
  "description": "Execute SQL query.",
  "input_schema": {
    "type": "object",
    "properties": {
      "brief": {
        "type": "string",
        "description": "One-sentence purpose of the operation"
      },
      "query": {
        "type": "string"
      }
    },
    "required": [
      "brief",
      "query"
    ]
  },
  "policy": {
    "requires_confirmation": true,
    "destructive": true,
    "side_effects": "changes_database"
  }
}
